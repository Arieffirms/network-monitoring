# ==========================================
# Konfigurasi Port Host Monitoring
# ==========================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
NODE_EXPORTER_PORT=9100

# ==========================================
# Kredensial Akun Admin Grafana
# ==========================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Admin123!

# ==========================================
# Telegram Alerting (OPSIONAL)
# ==========================================
# Biarkan kosong jika HANYA ingin monitoring visual di Grafana tanpa notifikasi Telegram.
# Jika ingin notifikasi bot aktif, isi Token Bot dan Chat ID Telegram Anda.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# Konfigurasi MikroTik Fisik (Production PT BPS)
# ==========================================
# Target Router Gateway
MIKROTIK_PROD_HOST=192.168.2.1
MIKROTIK_PROD_PORT=161
MIKROTIK_COMMUNITY=grafana-bps

# IP Kabel LAN Host Monitoring (Interface enp7s0)
# Pastikan IP ini diizinkan di Winbox (IP > SNMP > Communities > grafana-bps)
HOST_LAN_IP=192.168.2.175
